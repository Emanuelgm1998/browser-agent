from __future__ import annotations

import asyncio
import json
import re
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

from pydantic import BaseModel, Field

from chat_brain import ChatBrain


BASE_DIR = Path(__file__).resolve().parent
LOG_DIR = BASE_DIR / "logs"
LOG_DIR.mkdir(exist_ok=True)


class PlanStep(BaseModel):
    action: str
    description: str
    target: str | None = None


class FinalPlan(BaseModel):
    goal: str
    summary: str
    steps: list[PlanStep] = Field(min_length=1)
    risks: list[str] = Field(default_factory=list)
    requires_human_approval: bool = True


def extract_json(text: str) -> dict[str, Any]:
    text = text.strip()

    # 1. JSON directo
    try:
        data = json.loads(text)
        if isinstance(data, dict):
            return data
    except json.JSONDecodeError:
        pass

    # 2. JSON dentro de markdown
    fenced = re.search(
        r"```(?:json)?\s*(\{.*?\})\s*```",
        text,
        re.DOTALL | re.IGNORECASE,
    )

    if fenced:
        try:
            data = json.loads(fenced.group(1))
            if isinstance(data, dict):
                return data
        except json.JSONDecodeError:
            pass

    # 3. Buscar objeto JSON balanceado
    start = text.find("{")

    if start == -1:
        raise ValueError("No se encontró ningún objeto JSON en la respuesta.")

    depth = 0
    in_string = False
    escape = False

    for index in range(start, len(text)):
        char = text[index]

        if in_string:
            if escape:
                escape = False
            elif char == "\\":
                escape = True
            elif char == '"':
                in_string = False
            continue

        if char == '"':
            in_string = True
        elif char == "{":
            depth += 1
        elif char == "}":
            depth -= 1

            if depth == 0:
                candidate = text[start:index + 1]

                try:
                    data = json.loads(candidate)
                    if isinstance(data, dict):
                        return data
                except json.JSONDecodeError:
                    pass

                break

    raise ValueError("No se pudo extraer un JSON válido de la respuesta.")


def validate_plan(text: str) -> FinalPlan:
    data = extract_json(text)
    return FinalPlan.model_validate(data)


async def call_brain(
    brain: ChatBrain,
    method_name: str,
    prompt: str,
) -> str:
    method = getattr(brain, method_name)

    result = method(prompt)

    if asyncio.iscoroutine(result):
        result = await result

    if not isinstance(result, str):
        result = str(result)

    return result.strip()


async def run_reasoning(task: str) -> FinalPlan:
    print("")
    print("=" * 60)
    print(" MVP1 DUAL BRAIN REASONING LOOP")
    print("=" * 60)
    print("")
    print(f"TAREA: {task}")
    print("")

    async with ChatBrain() as brain:

        # ---------------------------------------------------------
        # 1. CHATGPT -> PLAN INICIAL
        # ---------------------------------------------------------
        print("[1/3] ChatGPT -> PLAN INICIAL")
        print("")

        chatgpt_prompt = f"""
You are the primary planning brain of an autonomous browser agent.

User task:
{task}

Create a clear execution plan for a browser agent.

Requirements:
- Break the task into concrete browser actions.
- Identify the target URLs or pages when possible.
- Identify verification criteria.
- Identify risks or sensitive actions.
- Do not execute anything.
- Return a human-readable plan for Claude to review.
"""

        initial_plan = await call_brain(
            brain,
            "ask_chatgpt",
            chatgpt_prompt,
        )

        print("CHATGPT PLAN RECIBIDO.")
        print("")
        print(initial_plan)
        print("")

        # ---------------------------------------------------------
        # 2. CLAUDE -> REVIEW
        # ---------------------------------------------------------
        print("[2/3] Claude -> REVIEW")
        print("")

        claude_prompt = f"""
You are the reviewing brain of an autonomous browser agent.

Original user task:
{task}

Initial plan generated by ChatGPT:
{initial_plan}

Review this plan.

Check:
- correctness
- missing steps
- browser navigation issues
- verification requirements
- dangerous or sensitive actions
- ambiguity

Return a concise review and concrete corrections.

Do not execute anything.
"""

        review = await call_brain(
            brain,
            "ask_claude",
            claude_prompt,
        )

        print("CLAUDE REVIEW RECIBIDO.")
        print("")
        print(review)
        print("")

        # ---------------------------------------------------------
        # 3. CHATGPT -> PLAN FINAL JSON
        # ---------------------------------------------------------
        print("[3/3] ChatGPT -> PLAN FINAL JSON")
        print("")

        final_prompt = f"""
You are the final planning brain for an autonomous browser agent.

User task:
{task}

Initial ChatGPT plan:
{initial_plan}

Claude review:
{review}

Create the FINAL execution plan.

IMPORTANT:
Return ONLY valid JSON.
Do not use markdown.
Do not add explanations outside JSON.

Required schema:

{{
  "goal": "string",
  "summary": "string",
  "steps": [
    {{
      "action": "string",
      "description": "string",
      "target": "string or null"
    }}
  ],
  "risks": [
    "string"
  ],
  "requires_human_approval": true
}}

Rules:
- steps must contain at least one item.
- actions must be concrete browser actions.
- include verification steps.
- never invent credentials.
- never include passwords, API keys, cookies, security codes, or secrets.
- sensitive actions must require human approval.
"""

        final_response = await call_brain(
            brain,
            "ask_chatgpt",
            final_prompt,
        )

        print("RESPUESTA FINAL RECIBIDA.")
        print("")

        # ---------------------------------------------------------
        # VALIDACION JSON / PYDANTIC
        # ---------------------------------------------------------
        print("[VALIDACIÓN] Analizando JSON...")

        try:
            plan = validate_plan(final_response)
        except Exception as exc:
            print("")
            print("ERROR: el plan final no pudo validarse.")
            print(f"Detalle: {exc}")
            print("")
            print("RESPUESTA RECIBIDA:")
            print(final_response)
            print("")
            raise

        print("OK: JSON válido.")
        print("OK: esquema Pydantic válido.")
        print("")

        # ---------------------------------------------------------
        # MOSTRAR PLAN
        # ---------------------------------------------------------
        print("=" * 60)
        print(" PLAN FINAL")
        print("=" * 60)
        print("")

        print(json.dumps(
            plan.model_dump(),
            indent=2,
            ensure_ascii=False,
        ))

        print("")

        # ---------------------------------------------------------
        # LOG
        # ---------------------------------------------------------
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        log_path = LOG_DIR / f"reasoning_{timestamp}.json"

        log_data = {
            "timestamp": datetime.now().isoformat(),
            "task": task,
            "initial_plan": initial_plan,
            "claude_review": review,
            "final_response": final_response,
            "validated_plan": plan.model_dump(),
        }

        log_path.write_text(
            json.dumps(
                log_data,
                indent=2,
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )

        print(f"LOG: {log_path}")
        print("")

        # ---------------------------------------------------------
        # HUMAN GATE
        # ---------------------------------------------------------
        print("=" * 60)
        print(" APROBACIÓN HUMANA")
        print("=" * 60)
        print("")

        if plan.requires_human_approval:
            print("Este plan requiere aprobación humana antes de ejecutar.")
            print("")

            while True:
                answer = input(
                    "¿Aprobar este plan? [y/N]: "
                ).strip().lower()

                if answer in {"y", "yes", "s", "si", "sí"}:
                    print("")
                    print("PLAN APROBADO.")
                    break

                if answer in {"", "n", "no"}:
                    print("")
                    print("PLAN RECHAZADO.")
                    return plan

                print("Respuesta no válida. Usa y o N.")

        else:
            print("El plan no requiere aprobación adicional.")

        print("")
        print("=" * 60)
        print(" PLAN VALIDADO Y APROBADO")
        print("=" * 60)
        print("")
        print("NOTA: el executor Browser Agent todavía no está conectado.")
        print("Esta fase valida ChatGPT -> Claude -> ChatGPT -> JSON -> Human Gate.")
        print("")

        return plan


def main() -> None:
    if len(sys.argv) < 2:
        print("")
        print("Uso:")
        print("")
        print('python reasoning_loop.py "tu tarea de navegador"')
        print("")
        sys.exit(1)

    task = " ".join(sys.argv[1:]).strip()

    try:
        asyncio.run(run_reasoning(task))
    except KeyboardInterrupt:
        print("")
        print("Interrumpido por el usuario.")
        print("")
        sys.exit(130)
    except Exception as exc:
        print("")
        print("=" * 60)
        print(" ERROR EN REASONING LOOP")
        print("=" * 60)
        print("")
        print(type(exc).__name__ + ":", exc)
        print("")
        sys.exit(1)


if __name__ == "__main__":
    main()
